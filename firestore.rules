rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // CORRIGIDO: checagem direcional, não mais OR simétrico (que nunca
    // bloqueava nada, conforme apontado pelo Codex). Residual: em caso de
    // duas requisições concorrentes criando cada papel ao mesmo tempo, ainda
    // existe uma janela de corrida — mitigação real definitiva exigiria
    // transação server-side (fora do escopo Spark). Aceito como risco
    // residual documentado.
    function canBecomeClient(uid) {
      return !exists(/databases/$(database)/documents/gas_stations/$(uid));
    }

    function canBecomeStation(uid) {
      return !exists(/databases/$(database)/documents/users/$(uid));
    }

    // Confirma o papel privado do posto no estado final da operação.
    // getAfter mantém compatibilidade com o cadastro atômico que cria
    // gas_stations/{uid} e public_stations/{uid} no mesmo batch.
    function hasStationRoleAfter(uid) {
      return getAfter(
        /databases/$(database)/documents/gas_stations/$(uid)
      ).data.type == 'gas_station';
    }

    // Denuncia de avaliacao: autor declarado bate com o dono do documento e
    // motivo vem da lista fechada do app.
    function validReport(data, reporterUid) {
      return data.reporterUid == reporterUid
        && data.reason in [
             'offensive', 'fake', 'off_topic',
             'spam', 'personal_data', 'other'
           ];
    }

    // Formato público consumido pelos clientes. Mesmo intervalo do formulário.
    function validFuelPrice(value) {
      return value == null || (value is number && value >= 0.01 && value <= 99.999);
    }

    function validPrices(prices) {
      return prices is map
        && prices.keys().hasOnly(['gasolineRegular', 'gasolineAdditive', 'ethanol', 'dieselS10', 'dieselS500'])
        && validFuelPrice(prices.get('gasolineRegular', null))
        && validFuelPrice(prices.get('gasolineAdditive', null))
        && validFuelPrice(prices.get('ethanol', null))
        && validFuelPrice(prices.get('dieselS10', null))
        && validFuelPrice(prices.get('dieselS500', null));
    }

    function validPeriod(period) {
      return period == null || (period is map
        && period.keys().hasOnly(['open', 'close'])
        && period.open is string && period.close is string
        && period.open.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && period.close.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
    }

    function validHours(hours) {
      return hours is map
        && hours.keys().hasOnly(['monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday', 'sunday'])
        && validPeriod(hours.get('monday', null))
        && validPeriod(hours.get('tuesday', null))
        && validPeriod(hours.get('wednesday', null))
        && validPeriod(hours.get('thursday', null))
        && validPeriod(hours.get('friday', null))
        && validPeriod(hours.get('saturday', null))
        && validPeriod(hours.get('sunday', null));
    }

    // `street`/`number`/`cep` entraram depois de `address`; postos antigos não
    // os têm, então usamos `get(campo, padrao)` — valida o formato quando o
    // campo existe sem rejeitar documento legado. `cep` é só dígitos (o client
    // tira a máscara) e pode ser vazio quando o dono não informou.
    function validPublicStation(data) {
      return data.brandName is string
        && data.address is string && data.neighborhood is string
        && data.get('street', '') is string
        && data.get('street', '').size() <= 200
        && data.get('number', '') is string
        && data.get('number', '').size() <= 10
        && data.get('cep', '') is string
        && data.get('cep', '').matches('^([0-9]{8})?$')
        && data.get('brand', '') is string
        && data.latitude is number && data.latitude >= -90 && data.latitude <= 90
        && data.longitude is number && data.longitude >= -180 && data.longitude <= 180
        && validPrices(data.prices) && validHours(data.openingHours)
        && data.pricesUpdatedAt is timestamp
        && data.averageRating is number && data.averageRating >= 0 && data.averageRating <= 5
        && data.reviewCount is int && data.reviewCount >= 0
        && data.services is list && data.services.size() <= 20
        && data.tags is list && data.tags.size() <= 20;
    }

    // Denuncias via collectionGroup, para a tela de admin. Sem esta regra
    // uma query `collectionGroup('reports')` e negada e o admin so consegue
    // ler uma denuncia por vez, sabendo o caminho exato -- ou seja, nao
    // consegue descobrir que existe denuncia nova.
    //
    // Pega as duas colecoes chamadas `reports` (denuncia de posto e de
    // avaliacao). O app distingue pelo caminho do documento, nao por campo:
    // quem esta sob `reviews/` e denuncia de avaliacao. Isso evita campo
    // redundante e indice extra.
    //
    // Concede somente `list`. Ler um documento especifico continua regido
    // pelas regras de cada caminho (que tambem exigem admin).
    match /{path=**}/reports/{reportId} {
      allow list: if isAdmin();
    }

    // Histórico pessoal via collectionGroup: consulta limitada ao autor.
    // Reviews de um posto continuam públicas; isto não concede escrita.
    match /{path=**}/reviews/{reviewId} {
      allow list: if isSignedIn()
                  && resource.data.clientUid == request.auth.uid;
    }

    // ---------- users (privado) ----------
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
                    && request.resource.data.type == 'client'
                    && canBecomeClient(uid);
      allow update: if isOwner(uid) && request.resource.data.type == 'client';
      allow delete: if isOwner(uid);

      match /favorites/{stationId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---------- gas_stations (privado, dados sensíveis) ----------
    match /gas_stations/{uid} {
      // MUDANCA DELIBERADA (tela de admin): o admin precisa conferir CNPJ,
      // e-mail e telefone para aprovar um posto novo. Antes esta colecao era
      // ilegivel para todos menos o dono, inclusive para admin, e havia um
      // teste garantindo isso. A garantia foi trocada a pedido explicito:
      // admin le, terceiro continua sem ler. Ver ADMIN.md.
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
                    && request.resource.data.type == 'gas_station'
                    && canBecomeStation(uid);
      allow update: if isOwner(uid) && request.resource.data.type == 'gas_station';
      allow delete: if isOwner(uid);
    }

    // ---------- public_stations (leitura pública) ----------
    match /public_stations/{uid} {
      allow read: if true;

      // Dono do posto: pode alterar qualquer campo (preços, horários, etc.)
      // Posto novo nasce pendente de aprovacao. O dono NAO escolhe o
      // status; so o admin muda depois (caso 3 do update).
      allow create: if isOwner(uid)
                    && hasStationRoleAfter(uid)
                    && validPublicStation(request.resource.data)
                    && request.resource.data.status == 'pending'
                    && request.resource.data.state == 'SP'
                    && request.resource.data.city is string
                    && request.resource.data.citySearchKey is string
                    && request.resource.data.citySearchKey.size() > 0
                    && request.resource.data.citySearchKey.size() <= 100
                    && request.resource.data.services.size() <= 20
                    && request.resource.data.tags.size() <= 20;

      allow update: if
        // Caso 1: dono do posto altera qualquer campo do próprio posto.
        (isOwner(uid)
          && hasStationRoleAfter(uid)
          && validPublicStation(request.resource.data)
          // Sem isto o dono se aprovaria sozinho: o caso 1 libera qualquer
          // campo do proprio documento. `get` com padrao aceita documento
          // antigo, que nao tem o campo.
          && request.resource.data.get('status', '') == resource.data.get('status', '')
          && request.resource.data.state == 'SP'
          && request.resource.data.city is string
          && request.resource.data.citySearchKey is string
          && request.resource.data.citySearchKey.size() > 0
          && request.resource.data.citySearchKey.size() <= 100
          && request.resource.data.services.size() <= 20
          && request.resource.data.tags.size() <= 20)
        ||
        // Caso 2: qualquer cliente autenticado pode atualizar SOMENTE os
        // agregados de review (averageRating/reviewCount), na mesma
        // transação em que grava sua review. Nenhum outro campo pode mudar.
        // LIMITAÇÃO CONHECIDA (documentada, não eliminada sem backend):
        // rules não conseguem verificar que essa escrita corresponde a uma
        // review real no mesmo batch — mitigamos restringindo a variação
        // permitida por escrita (no máximo +1 review, rating dentro da
        // faixa), não o abuso completo. Ver SCHEMA-FIRESTORE.md.
        (isSignedIn()
          && request.resource.data.averageRating is number
          && request.resource.data.reviewCount is int
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['averageRating', 'reviewCount'])
          && request.resource.data.averageRating >= 0
          && request.resource.data.averageRating <= 5
          && request.resource.data.reviewCount >= 0
          && request.resource.data.reviewCount <= resource.data.reviewCount + 1)
        ||
        // Caso 3: admin aprova ou recusa o posto. Altera SOMENTE `status`,
        // nenhum outro campo -- nem preco, nem endereco, nem agregado.
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status'])
          && request.resource.data.status in ['pending', 'approved', 'rejected']);

      allow delete: if isOwner(uid);

      match /reviews/{clientUid} {
        allow read: if true;
        allow create: if isOwner(clientUid)
                      && request.resource.data.rating >= 1
                      && request.resource.data.rating <= 5;

        // Avaliacao e UNICA e definitiva: o cliente escreve uma vez e nao
        // reescreve. O id do documento ja era o uid dele, entao nunca houve
        // duplicata -- o que mudou e que a primeira agora e a final.
        // Sem esta regra o client podia trocar a nota depois, e o agregado
        // do posto era recalculado a cada troca.
        allow update: if false;
        // Admin apaga review denunciada (tela de admin). Corrigir
        // averageRating/reviewCount depois NAO exigiu regra nova: o caso 2
        // do update de public_stations ja permite diminuir reviewCount.
        allow delete: if isOwner(clientUid) || isAdmin();

        // CORRIGIDO: caminho tinha número ímpar de segmentos (inválido).
        // Agora: public_stations/{uid}/reviews/{clientUid}/reports/{reporterUid}
        match /reports/{reporterUid} {
          allow read: if isAdmin();

          // Motivo vem de lista fechada (o app mostra opcoes, nao campo
          // livre). Antes `create` nao validava nada: qualquer string
          // passava. Mantem os valores em sincronia com o enum
          // `ReportReason` de shared/models/report_reason.dart.
          allow create: if isOwner(reporterUid)
                        && validReport(request.resource.data, reporterUid)
                        && request.resource.data.status == 'pending';

          // O id do documento e o uid de quem denuncia, entao denunciar de
          // novo a avaliacao do MESMO cliente cai no mesmo caminho e vira
          // `update`. Isso e legitimo: a avaliacao anterior pode ter sido
          // removida e o cliente ter escrito outra. Sem esta regra o posto
          // ficava travado em cima da propria denuncia antiga.
          //
          // O que ele NAO pode e mexer no veredito: ao redenunciar, `status`
          // so pode voltar para 'pending'. Marcar a propria denuncia como
          // resolvida esconderia ela do admin.
          allow update: if isAdmin()
                        || (isOwner(reporterUid)
                            && validReport(request.resource.data, reporterUid)
                            && request.resource.data.status == 'pending');

          allow delete: if isAdmin();
        }
      }
    }

    // ---------- station_covers (foto de exibição do posto) ----------
    // Documento à parte de public_stations de propósito: a query da listagem
    // do motorista lê public_stations em lote (.limit) e não pode baixar a
    // foto de dezenas de postos junto — a foto é carregada sob demanda ao
    // abrir um posto. Ver ARCHITECTURE.md seção 6.
    //
    // Leitura pública (o cliente vê a foto no detalhe). Escrita só do dono,
    // com teto no tamanho do base64 para caber no limite de 1 MiB por
    // documento do Firestore (o client já comprime para ~500 KB).
    match /station_covers/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
                            && hasStationRoleAfter(uid)
                            && request.resource.data.image is string
                            && request.resource.data.image.size() > 0
                            && request.resource.data.image.size() <= 700000;
      allow delete: if isOwner(uid);
    }

    // ---------- station_reports (denúncia de posto) ----------
    // CORRIGIDO: caminho precisa de coleção intermediária para ter número
    // par de segmentos. Antes: station_reports/{stationUid}/{reporterUid}
    // (inválido, 3 segmentos). Agora: .../reports/{reporterUid}.
    match /station_reports/{stationUid}/reports/{reporterUid} {
      allow read: if isAdmin();
      allow create: if isOwner(reporterUid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
